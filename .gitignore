# Environment
.env
.env.*
!.env.example

# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ML model artifacts (downloaded/converted at runtime by entrypoint.sh)
*.tflite
*_openvino_model/

# Test caches
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Docs / internal plans. `docs/*` rather than `docs/` so the negation below can
# apply — git does not descend into an excluded directory, so a `!` rule inside
# one is never reached.
docs/*
!docs/experiments/

*.pt
*.karas

# Region crops written when AWS_ALLOWED_UPLOADED=false
uploads/

docs/
