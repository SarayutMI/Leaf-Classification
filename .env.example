PORT=8000

# S3 model storage + dataset uploads
S3_BUCKET=your-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
# false = classify still runs; cropped regions go to LOCAL_UPLOAD_DIR instead of S3
AWS_ALLOWED_UPLOADED=true
# Where region crops are written when AWS_ALLOWED_UPLOADED=false
LOCAL_UPLOAD_DIR=./uploads

# Optional model overrides (entrypoint.sh sets YOLO_MODEL_PATH automatically)
# YOLO_WEIGHTS=yolo11x_leaf.pt
# YOLO_MODEL_PATH=
# NUM_THREADS=2
# SKIP_MODEL_OPTIMIZE=0

# Classifier models. Locally the path is used as-is; in Docker only the file
# name matters (entrypoint.sh fetches it from ml_models/ on S3).
#   <name>.tflite  fetch the TFLite file only, e.g. SHAPE_MODEL_PATH=NewShape_.tflite
#   <name>.keras   fetch the .keras, then its .tflite (or convert once)
# SHAPE_MODEL_PATH=./Model_Classification/R50_Shape_final_V0.keras
# APEX_MODEL_PATH=./Model_Classification/R50_Apex_final_V1.keras
# BASE_MODEL_PATH=./Model_Classification/R50_Base_final_V1.keras
# MARGIN_MODEL_PATH=./Model_Classification/R50_Margin_final_V1.keras
