PORT=8000

# S3 model storage + dataset uploads
S3_BUCKET=your-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
# false = classify still runs; cropped regions go to LOCAL_UPLOAD_DIR instead of S3
AWS_ALLOWED_UPLOADED=true
# Where region crops are written when AWS_ALLOWED_UPLOADED=false
LOCAL_UPLOAD_DIR=./uploads

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=leaf_db

# Optional: set before first startup to control the seed account.
# If SEED_PASSWORD is left blank, a strong random password is generated and printed once.
SEED_USERNAME=admin
SEED_PASSWORD=

# Optional model overrides (entrypoint.sh sets YOLO_MODEL_PATH automatically)
# YOLO_WEIGHTS=yolo11x_leaf.pt
# YOLO_MODEL_PATH=
# NUM_THREADS=2
# SKIP_MODEL_OPTIMIZE=0
