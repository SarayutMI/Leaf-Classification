PORT=8000

# S3 model storage + dataset uploads
S3_BUCKET=your-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
# false = classify still runs, but cropped regions are not uploaded to S3
AWS_ALLOWED_UPLOADED=true

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=leaf_db

# Optional: set before first startup to control the seed account.
# If SEED_PASSWORD is left blank, a strong random password is generated and printed once.
SEED_USERNAME=admin
SEED_PASSWORD=

# Admin session for the rule-base page at /admin/ (JWT in an HttpOnly cookie).
# JWT_SECRET is REQUIRED — the app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
SESSION_COOKIE_NAME=leaf_session
# Set true wherever /admin is served over HTTPS
COOKIE_SECURE=false

# Optional model overrides (entrypoint.sh sets YOLO_MODEL_PATH automatically)
# YOLO_WEIGHTS=yolo11x_leaf.pt
# YOLO_MODEL_PATH=
# NUM_THREADS=2
# SKIP_MODEL_OPTIMIZE=0
